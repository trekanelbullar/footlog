# ORCA API のベース URL
ORCA_BASE_URL=
# ORCA API の認証キー
ORCA_API_KEY=
# Supabase プロジェクトの URL（クライアント公開可）
NEXT_PUBLIC_SUPABASE_URL=
# Supabase の匿名キー（クライアント公開可・RLS 前提）
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Supabase のサービスロールキー（サーバー専用・RLS をバイパス）
SUPABASE_SERVICE_ROLE_KEY=
# Resend（メール送信）の API キー
RESEND_API_KEY=
# 通知メールの送信元アドレス
MAIL_FROM=
# アプリの公開 URL（メール内リンク生成などに使用）
APP_BASE_URL=
# 定期実行エンドポイントを保護する共有シークレット
CRON_SECRET=
# 1 日あたりの AI 利用コスト上限（USD）
DAILY_COST_LIMIT_USD=
# システム障害・コスト超過アラートの送信先メールアドレス
SYSTEM_ALERT_EMAIL=
# GCP プロジェクト ID（デプロイ時に使用）
GCP_PROJECT_ID=

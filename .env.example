# Copy this file to .env and replace the placeholder locally.
# Never commit a real API key.
ORCAROUTER_API_KEY=replace_with_your_api_key
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_MODEL=qwen/qwen3.7-flash
ORCAROUTER_TIMEOUT_SECONDS=30
ORCAROUTER_MAX_RETRIES=2
ORCAROUTER_MAX_TOKENS=500
ORCAROUTER_MAX_PROMPT_CHARS=20000
# 段階ごと（EXTRACT・SUPPORT・AGENT・ASSEMBLE・JUDGE）のモデル・思考モード・出力上限。
# 未設定ならモデルは ORCAROUTER_MODEL、出力上限は抽出・組み立てが4000、それ以外は
# ORCAROUTER_MAX_TOKENS を使う（代表として EXTRACT のみ例を示す）。
# ORCAROUTER_MODEL_EXTRACT=
# ORCAROUTER_REASONING_EXTRACT=off
# ORCAROUTER_MAX_TOKENS_EXTRACT=
# 思考モードが off 以外の段階で、出力上限がこの値未満なら引き上げる
ORCAROUTER_REASONING_MIN_MAX_TOKENS=16000
# Postgres（Supabase）への接続文字列
DATABASE_URL=
# Supabase プロジェクトの URL
SUPABASE_URL=
# Supabase のサービスロールキー（サーバー専用・RLS をバイパス）
SUPABASE_SERVICE_ROLE_KEY=
# Supabase JWT の署名アルゴリズム（ES256 / RS256 / HS256 のいずれか）
SUPABASE_JWT_ALG=
# SUPABASE_JWT_ALG=HS256 のときだけ必須の共有鍵
SUPABASE_JWT_SECRET=
# Resend（メール送信）の API キー
RESEND_API_KEY=
# 通知メールの送信元アドレス
MAIL_FROM=
# アプリの公開 URL（メール内リンク生成などに使用）
APP_BASE_URL=
# web のサーバーから worker を呼ぶときの合言葉
WORKER_SHARED_SECRET=
# 定期実行エンドポイントを保護する共有シークレット
CRON_SECRET=
# 1 日あたりの AI 利用コスト上限（USD）
DAILY_COST_LIMIT_USD=
# システム障害・コスト超過アラートの送信先メールアドレス
SYSTEM_ALERT_EMAIL=
# プロンプトのテキストファイルを置くディレクトリ（未設定ならリポジトリ直下の prompts/）
PROMPTS_DIR=
# マイグレーション専用の接続文字列（Supabase の postgres ユーザー）。db/migrate.py だけが読む。
# アプリ（worker）は読まない。普段は空のままにし、マイグレーションのときだけ設定する
MIGRATION_DATABASE_URL=
# test のときだけ、起動時の接続ユーザー（app_worker）の確認を飛ばす。本番・手元では空のまま
APP_ENV=
